# ---------------------------------------------------------------------------
# CaretakerMatch — environment variables
# Copy to .env.local for local dev, and set the same keys in
# Railway → your service → Variables for production.
# ---------------------------------------------------------------------------

# Canonical site origin. Drives canonical tags, OG URLs, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://caretakermatch.com

# --- Form delivery ---------------------------------------------------------
# Pick ONE of the two options below. With neither set, submissions are written
# to the server log and the visitor is told to email us directly.

# Option 1 (recommended): Resend. One API key, free tier covers us comfortably.
# Sign up at resend.com, create an API key, paste it here.
# Until caretakermatch.com is verified as a sending domain, leave
# CONTACT_FROM_EMAIL unset and mail goes out from Resend's shared sender.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hamid.sabet@caretakermatch.com
# CONTACT_FROM_EMAIL=noreply@caretakermatch.com

# Option 2: Formspree. Create two forms and paste the endpoints.
# FORMSPREE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
# FORMSPREE_PARTNER_ENDPOINT=https://formspree.io/f/yyyyyyyy
